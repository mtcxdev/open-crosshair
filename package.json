{
  "name": "open-crosshair",
  "version": "1.0.0",
  "description": "Open source, 100% offline Crosshair overlay and studio with brutalist UI",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"vite\" \"electron .\"",
