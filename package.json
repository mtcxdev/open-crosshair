{
  "name": "open-crosshair",
  "version": "1.1.2",
  "description": "An open-source, 100% offline, local-first precision crosshair overlay and vector studio with modern customizable UI.",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtcxdev/open-crosshair.git"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:all": "vite build && electron-builder -mwl"
  },
  "keywords": [
    "crosshair",
    "overlay",
    "gaming",
    "esports",
    "open-source",
    "brutalist",
    "obs-studio"
  ],
  "author": "MTCX DEV <mtcx999@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.7.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.opencrosshair.app",
    "productName": "OpenCrosshair",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "overlay/**/*",
      "streamer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OpenCrosshair",
      "differentialPackage": false
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Game"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.games",
      "identity": null
    }
  }
}
